{
  "name": "agent-messaging-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:fixture": "node tests/fixtures/server.mjs",
    "build": "npm run build:companion && npm run build:extension",
    "build:companion": "npm run build --workspace @agent-messaging/companion",
    "build:extension": "npm run build --workspace @agent-messaging/extension",
    "verify:extension": "node packages/extension/verify-build.mjs",
    "typecheck": "npm run typecheck --workspace @agent-messaging/companion && npm run typecheck --workspace @agent-messaging/extension",
    "test:unit": "node --test tests/fixtures/*.test.mjs packages/companion/dist/*.test.js",
    "test:unit:build": "npm run build:companion && npm run test:unit",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:focus": "node --test --test-concurrency=1",
    "register:native": "npm run build:companion && node packages/companion/dist/register-native.js register",
    "restore:native": "npm run build:companion && node packages/companion/dist/register-native.js restore",
    "unregister:native": "npm run build:companion && node packages/companion/dist/register-native.js unregister",
    "dev:broker": "npm run build:companion && node packages/companion/dist/broker-process.js"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
